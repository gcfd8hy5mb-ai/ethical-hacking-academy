rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function enrolled(academyId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && academyId in ['business', 'law', 'ethical-hacking']
        && request.auth.token.keys().hasAll(['academies'])
        && request.auth.token.academies is list
        && academyId in request.auth.token.academies;
    }
    function ownRecord(userId, academyId) {
      return request.auth != null
        && request.auth.uid == userId
        && enrolled(academyId);
    }
    match /users/{userId}/academies/{academyId}/snapshots/{snapshotId} {
      allow get, list: if ownRecord(userId, academyId);
      allow create, update: if ownRecord(userId, academyId)
        && request.resource.data.keys().hasOnly(['raw', 'schemaVersion', 'updatedAt', 'academy'])
        && request.resource.data.keys().hasAll(['raw', 'schemaVersion', 'updatedAt', 'academy'])
        && request.resource.data.raw is string
        && request.resource.data.raw.size() <= 800000
        && request.resource.data.schemaVersion == 1
        && request.resource.data.academy == academyId
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
